# Copy this file to .env.local and fill it in. Never commit .env.local.
# The same variables go into Vercel → Project → Settings → Environment Variables.
# Anything starting with NEXT_PUBLIC_ is sent to the browser; everything else is server-only.

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the app, no trailing slash. Used in Telegram links and OAuth redirects.
# Local: http://localhost:3000   Production: https://church-media-hub-khaki.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (phase 1) ───────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. Safe in the browser because Row Level Security guards the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret (service role) key. Bypasses Row Level Security: server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Drive (phase 2) ───────────────────────────────────────────────────
# OAuth client for connecting the church Google account (Google Cloud Console → Credentials).
# This is separate from the Google sign-in configured inside Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts the church account's refresh token before it is stored.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Telegram (phase 6) ───────────────────────────────────────────────────────
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, used to build links to it.
TELEGRAM_BOT_USERNAME=
# Any long random string. Telegram sends it back in a header on every webhook call
# so the app can reject requests that are not from Telegram.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Scheduled jobs (phase 7) ─────────────────────────────────────────────────
# Any long random string. The scheduler sends it in a header when calling /api/cron/*.
# Generate with: openssl rand -hex 32
CRON_SECRET=
