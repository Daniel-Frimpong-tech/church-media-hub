# Copy this file to .env.local and fill it in. Never commit .env.local.
# The same variables go into Vercel → Project → Settings → Environment Variables.
# Anything starting with NEXT_PUBLIC_ is sent to the browser; everything else is server-only.

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the app, no trailing slash. Used for links in Telegram messages.
# Local: http://localhost:3000
# On Vercel you can leave this out: the live site's address is detected
# automatically. Set it there only to override, e.g. after adding a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (phase 1) ───────────────────────────────────────────────────────
# Project URL: Supabase dashboard → Project Settings → Data API (or the Connect button).
# It looks like https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → "Publishable and secret API keys" tab.
# Publishable key (starts with sb_publishable_). Safe in the browser because
# Row Level Security guards the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). Bypasses Row Level Security: server-only,
# never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# ── Google Drive (phase 2) ───────────────────────────────────────────────────
# OAuth client used to connect the church Google account (Google Cloud Console → Credentials).
# The same client that Supabase uses for Google sign-in works, as long as
# <app url>/api/google/callback is listed in its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts the church account's refresh token before it is stored.
# Generate with: openssl rand -base64 32
# Use the SAME value locally and on Vercel: both read the same database.
TOKEN_ENCRYPTION_KEY=

# ── Telegram (phase 6) ───────────────────────────────────────────────────────
# Optional: the app works without these, it just posts nothing to Telegram.
# Bot token from @BotFather. Anyone with it can control the bot.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @. For your own reference; the app asks Telegram for it.
TELEGRAM_BOT_USERNAME=
# Any long random string. Telegram sends it back in a header on every webhook call
# so the app can reject requests that are not from Telegram.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Scheduled jobs (phase 7) ─────────────────────────────────────────────────
# Any long random string. The scheduler sends it as "Authorization: Bearer <value>"
# when calling /api/cron/*.
# Generate with: openssl rand -hex 32
CRON_SECRET=
